{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codee.invalid/schemas/mcr-v1.schema.json",
  "title": "Codee Mathematical Construction Representation v1",
  "type": "object",
  "required": ["protocol", "project_id", "source_documents", "ambient_context", "objects", "operations", "claims", "targets"],
  "properties": {
    "protocol": {"const": "codee-mcr/1.0"},
    "project_id": {"type": "string", "minLength": 1},
    "source_documents": {"type": "array", "items": {"type": "object", "required": ["id", "locator"], "properties": {"id": {"type": "string"}, "locator": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": true}},
    "ambient_context": {"type": "object", "required": ["description"], "properties": {"description": {"type": "string"}, "base_ring": {"type": "string"}, "characteristic": {"type": ["integer", "string", "null"]}}, "additionalProperties": true},
    "objects": {"type": "array", "items": {"$ref": "#/$defs/mathObject"}},
    "operations": {"type": "array", "items": {"$ref": "#/$defs/operation"}},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
  },
  "additionalProperties": true,
  "$defs": {
    "sourceRef": {"type": "object", "required": ["document_id"], "properties": {"document_id": {"type": "string"}, "locator": {"type": "string"}}, "additionalProperties": true},
    "mathObject": {"type": "object", "required": ["id", "type", "definition", "exactness"], "properties": {"id": {"type": "string", "minLength": 1}, "type": {"type": "string", "minLength": 1}, "definition": {"type": "string", "minLength": 1}, "ambient": {"type": "string"}, "model": {"type": "string"}, "parameters": {"type": "array"}, "assumptions": {"type": "array", "items": {"type": "string"}}, "exactness": {"enum": ["EXACT", "CERTIFIED_NUMERIC", "HEURISTIC_NUMERIC", "FINITE_SAMPLE", "UNSPECIFIED"]}, "source_refs": {"type": "array", "items": {"$ref": "#/$defs/sourceRef"}}}, "additionalProperties": true},
    "operation": {"type": "object", "required": ["id", "operation", "inputs", "outputs", "preconditions"], "properties": {"id": {"type": "string", "minLength": 1}, "operation": {"type": "string", "minLength": 1}, "inputs": {"type": "array", "items": {"type": "string"}}, "outputs": {"type": "array", "items": {"type": "string"}}, "preconditions": {"type": "array", "items": {"type": "string"}}, "source_refs": {"type": "array", "items": {"$ref": "#/$defs/sourceRef"}}, "dependencies": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true},
    "claim": {"type": "object", "required": ["id", "statement_latex", "quantifiers", "premises", "depends_on", "origin", "source_refs"], "properties": {"id": {"type": "string", "minLength": 1}, "statement_latex": {"type": "string", "minLength": 1}, "quantifiers": {"type": "string"}, "premises": {"type": "array", "items": {"type": "string"}}, "depends_on": {"type": "array", "items": {"type": "string"}}, "origin": {"enum": ["AUTHOR_ASSERTED", "USER_PROVIDED", "CODEE_DERIVED", "EXTERNAL_THEOREM"]}, "source_refs": {"type": "array", "items": {"$ref": "#/$defs/sourceRef"}}, "claimed_proof_status": {"type": "string"}}, "additionalProperties": true}
  }
}
